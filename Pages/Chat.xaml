<Page x:Class="Leo.PageModels.Chat"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:res="clr-namespace:Leo.Properties"
      xmlns:sys="clr-namespace:System;assembly=System.Runtime"
      mc:Ignorable="d" 
      d:DesignHeight="560" d:DesignWidth="850"
      Background="#ff131313"
      Title="Chat" PreviewKeyDown="hotKeys">
    <Grid>
        <ScrollViewer Name="ScrollBox" Margin="0,20,0,80">
            <ItemsControl x:Name="ChatList" >
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="30,0,30,10" d:DataContext="{d:SampleData}">
                            <Grid Name="DateLabel" Visibility="Hidden">
                                <Rectangle Name="dateCloud" RadiusX="5" RadiusY="5" Fill="White" StrokeThickness="3" 
                                           HorizontalAlignment="Center" VerticalAlignment="Top" Stroke="White" Height="20" 
                                           Width="75"/>
                                <TextBlock Name="DateMessage" FontFamily="Montserrat Alternates" Foreground="Black" FontSize="12" 
                                           Text="{Binding Path=Date}" HorizontalAlignment="Center" 
                                           Margin="0,2,0,0"/>
                            </Grid>
                            <Grid Name="Grid" Margin="0,0,0,0">
                                <Rectangle Name="messageCloud" RadiusX="10" RadiusY="10" Fill="White" StrokeThickness="3" 
                                           HorizontalAlignment="{Binding Path=Alignment}" Stroke="White" Height="50" 
                                           Width="{Binding Path=Length}"/>
                                <StackPanel Name="Block" Margin="5">
                                    <TextBlock Name="Message" FontFamily="Montserrat Alternates" FontSize="14" Text="{Binding Path=MessageText}" 
                                               HorizontalAlignment="{Binding Path=Alignment}" Margin="4,2,4,0" />
                                    <TextBlock Name="Time" FontSize="9" FontFamily="Montserrat Alternates" Text="{Binding Path=Time}" 
                                               HorizontalAlignment="{Binding Path=Alignment}" Margin="4,2,4,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Path=IsDateVisible}" d:DataContext="{d:SampleData}" Value="true">
                                <Setter TargetName="DateLabel" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Grid" Property="Margin" Value="0,30,0,0"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Image HorizontalAlignment="Left" Height="356" Margin="-92,315,0,0" VerticalAlignment="Top" Width="319" Source="/assets/images/dragon.png" 
               Opacity="0.2" StretchDirection="DownOnly"/>
        <Rectangle HorizontalAlignment="Left" Height="234" Margin="-67,332,0,0" VerticalAlignment="Top" Width="66" Fill="#FF111111"/>
        <Border BorderThickness="1" Margin="25,495,25,20" Background="#ff000000" CornerRadius="10">
            <Grid>
                <Border BorderThickness="1" Height="28" Margin="755,0,0,0" VerticalAlignment="Center" Width="28" HorizontalAlignment="Left" 
                        CornerRadius="50" MouseLeftButtonDown="send" MouseEnter="sendBtnMouseEnter" MouseLeave="sendBtnMouseLeave">
                    <Grid Margin="-1,-1,-1,-1">
                        <Rectangle Name="SendButtonBackground" Height="28" VerticalAlignment="Center" Width="28" HorizontalAlignment="Center" Opacity="0" 
                                   RadiusX="8" RadiusY="8" Fill="White"/>
                        <Image Name="SendButton" HorizontalAlignment="Center" Height="24" VerticalAlignment="Center" Width="24" Source="/assets/images/send.png"/>
                    </Grid>
                </Border>
                <TextBox x:Name="TextBox" HorizontalAlignment="Left" Margin="10,0,0,0" TextWrapping="Wrap" 
                         VerticalAlignment="Center" Width="732" Background="{x:Null}" BorderBrush="{x:Null}" 
                         Foreground="White" SelectionBrush="White" CaretBrush="White"  BorderThickness="0,0,0,0" 
                         SelectionOpacity="1" IsTabStop="False" SpellCheck.IsEnabled="True" Language="ru-ru" 
                         TextChanged="messageBuffer" FontFamily="Montserrat Alternates"/>
            </Grid>
        </Border>
        <Border Height="220" Width="220" Background="Black" CornerRadius="10" VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,130,0,0">
            <Grid>
                <Image Height="120" Width="120" VerticalAlignment="Top" HorizontalAlignment="Center" Source="/assets/images/dragon.png"
                       Margin="0,25,0,0" RenderOptions.BitmapScalingMode="Fant"/>
                <TextBlock Text="{x:Static res:Resources.chatPage_welcomeLabel}" HorizontalAlignment="Center"
                           VerticalAlignment="Bottom" Foreground="White" FontFamily="Montserrat Alternates" 
                           Margin="0,0,0,20" TextAlignment="Center"
                           Height="35" Width="150" FontSize="14"/>
            </Grid>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Items.Count, ElementName=ChatList}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</Page>
