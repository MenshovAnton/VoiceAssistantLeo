<Page x:Class="Leo.PageModels.CommandsEditor"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:res="clr-namespace:Leo.Properties"
      mc:Ignorable="d"
      Background="#FF161616"
      Title="CommandEditor" Height="560" Width="850">
    <Page.Resources>
        <Image x:Key="BackImage" Source="/Assets/images/back.png"/>
    </Page.Resources>
    <Grid>
        <Button Style="{StaticResource FrameButtonsStyle}" Width="40" Height="40" Margin="60,60,0,0" VerticalAlignment="Top" 
                HorizontalAlignment="Left" Content="{StaticResource BackImage}" Click="back"/>
            
        <Label x:Name="Title" Content="Новая команда" HorizontalAlignment="Left" FontFamily="Montserrat Alternates" Margin="110,60,0,0" 
               FontSize="24" FontWeight="ExtraBold" Foreground="White" VerticalAlignment="Top"/>
        
        <Grid>
            <Label Content="Название команды" FontFamily="Montserrat Alternates" Foreground="White" Margin="60,120,0,0" 
                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Border VerticalAlignment="Top" HorizontalAlignment="Left" BorderThickness="1" Margin="60,150,25,20" 
                    Background="#FF0E0E0E" CornerRadius="10" Height="20" Width="320">
                <Grid>
                    <TextBox Name="CommandNameTextBox" HorizontalAlignment="Left" Margin="10,0,0,0" 
                             TextWrapping="Wrap" VerticalAlignment="Center" Width="320" 
                             Background="{x:Null}" BorderBrush="{x:Null}" Foreground="White" SelectionBrush="White" 
                             CaretBrush="White"  BorderThickness="0,0,0,0" 
                             SelectionOpacity="1" IsTabStop="False" SpellCheck.IsEnabled="True" Language="ru-ru" 
                             FontFamily="Montserrat Alternates"/>
                </Grid>
            </Border>
            
            <Label Content="Описание команды" FontFamily="Montserrat Alternates" Foreground="White" Margin="60,180,0,0" 
                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Border VerticalAlignment="Top" HorizontalAlignment="Left" BorderThickness="1" Margin="60,210,25,20" 
                    Background="#FF0E0E0E" CornerRadius="10" Height="20" Width="320">
                <Grid>
                    <TextBox Name="CommandDescriptionTextBox" HorizontalAlignment="Left" Margin="10,0,0,0" TextWrapping="Wrap" 
                             VerticalAlignment="Center" Width="320" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="White" 
                             SelectionBrush="White" CaretBrush="White"  BorderThickness="0,0,0,0" 
                             SelectionOpacity="1" IsTabStop="False" SpellCheck.IsEnabled="True" Language="ru-ru" FontFamily="Montserrat Alternates"/>
                </Grid>
            </Border>
            
            <Label Content="Ссылка на сайт или приложение" FontFamily="Montserrat Alternates" Foreground="White" Margin="60,240,0,0" 
                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Image Source="/Assets/Images/folder.png" Margin="360,270,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="20" 
                   Height="20" MouseDown="openFile" Cursor="Hand"/>
            <Border VerticalAlignment="Top" HorizontalAlignment="Left" BorderThickness="1" Margin="60,270,25,20" Background="#FF0E0E0E" 
                    CornerRadius="10" Height="20" Width="290">
                <Grid>
                    <TextBox Name="CommandLinkTextBox" HorizontalAlignment="Left" Margin="10,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" 
                             Width="280" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="White" SelectionBrush="White" CaretBrush="White"  
                             BorderThickness="0,0,0,0" SelectionOpacity="1" IsTabStop="False" SpellCheck.IsEnabled="True" Language="ru-ru" 
                             FontFamily="Montserrat Alternates"/>
                </Grid>
            </Border>
            
            <Label Content="Активационная фраза" FontFamily="Montserrat Alternates" Foreground="White" Margin="60,300,0,0" 
                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Border VerticalAlignment="Top" HorizontalAlignment="Left" BorderThickness="1" Margin="60,320,25,20" 
                    Background="#FF0E0E0E" CornerRadius="10" Height="20" Width="320">
                <Grid>
                    <TextBox Name="CommandPhraseTextBox" HorizontalAlignment="Left" Margin="10,0,0,0" TextWrapping="Wrap" 
                             VerticalAlignment="Center" Width="320" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="White" 
                             SelectionBrush="White" CaretBrush="White" BorderThickness="0,0,0,0" SelectionOpacity="1" 
                             IsTabStop="False" SpellCheck.IsEnabled="True" Language="ru-ru" FontFamily="Montserrat Alternates"/>
                </Grid>
            </Border>
            
            <Label Content="Ответ ассистента" FontFamily="Montserrat Alternates" Foreground="White" Margin="60,360,0,0" 
                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Border VerticalAlignment="Top" HorizontalAlignment="Left" BorderThickness="1" Margin="60,380,25,20" 
                    Background="#FF0E0E0E" CornerRadius="10" Height="20" Width="320">
                <Grid>
                    <TextBox Name="CommandReplyTextBox" HorizontalAlignment="Left" Margin="10,0,0,0" TextWrapping="Wrap" 
                             VerticalAlignment="Center" Width="320" Background="{x:Null}" BorderBrush="{x:Null}" 
                             Foreground="White" SelectionBrush="White" CaretBrush="White"  BorderThickness="0,0,0,0" 
                             SelectionOpacity="1" IsTabStop="False" SpellCheck.IsEnabled="True" Language="ru-ru" FontFamily="Montserrat Alternates"/>
                </Grid>
            </Border>
            </Grid>
            
            <Button Margin="70,440,0,0" Style="{StaticResource LeoButtonStyle}" Height="30" Width="180" 
                    Content="{x:Static res:Resources.commandsEditorPage_button_save}" FontFamily="Montserrat Alternates"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Click="writeNewCommand"/>
    </Grid>
</Page>
