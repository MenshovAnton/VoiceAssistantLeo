<Page x:Class="Leo.PageModels.CommandsViewer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Leo.PageModels"
      xmlns:res="clr-namespace:Leo.Properties"
      mc:Ignorable="d"
      Title="CommandsViewer" Width="850" Height="560" Background="#FF161616">
    <Grid>
        <Button Margin="20,30,0,0" Style="{StaticResource LeoButtonStyle}" Height="30" Width="180" 
                Content="{x:Static res:Resources.commandsViewerPage_button_add}" FontFamily="Montserrat Alternates"
                HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Button Margin="220,30,0,0" Style="{StaticResource LeoButtonStyle}" Height="30" Width="250" 
                Content="{x:Static res:Resources.commandsViewerPage_button_openJson}" FontFamily="Montserrat Alternates"
                HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Button Margin="490,30,0,0" Style="{StaticResource LeoButtonStyle}" Height="30" Width="180" 
                Content="{x:Static res:Resources.commandsViewerPage_button_import}" FontFamily="Montserrat Alternates"
                HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <ScrollViewer Name="ScrollBox" Margin="20,80,0,20">
            <ItemsControl x:Name="CommandsList" Background="#FF161616" BorderBrush="#FF161616" >
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,10,0,30">
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition MaxWidth="100"></ColumnDefinition>
                                <ColumnDefinition MaxWidth="500"></ColumnDefinition>
                                <ColumnDefinition MaxWidth="200"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Name="NameLabel" FontFamily="Montserrat Alternates" FontSize="14" 
                                       Foreground="White" Text="{x:Static res:Resources.commandsViewerPage_label_name}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Name="CommandName" FontFamily="Montserrat Alternates" FontSize="14" 
                                       Foreground="White" Text="{Binding Path=Name}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Name="DescriptionLabel" FontFamily="Montserrat Alternates" FontSize="14" 
                                       Foreground="White" Text="{x:Static res:Resources.commandsViewerPage_label_description}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Name="CommandDescription" FontFamily="Montserrat Alternates" FontSize="14" 
                                       Foreground="White" Text="{Binding Path=Description}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Name="PhraseLabel" FontFamily="Montserrat Alternates" FontSize="14" 
                                       Foreground="White" Text="{x:Static res:Resources.commandsViewerPage_label_phrase}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Name="CommandPhrase" FontFamily="Montserrat Alternates" FontSize="14" 
                                       Foreground="White" Text="{Binding Path=Phrase}"/>
                            
                            <Button Grid.Row="0" Grid.Column="2" Margin="0,0,0,5" Style="{StaticResource LeoButtonStyle}" Height="20" Width="160" 
                                    Content="{x:Static res:Resources.commandsViewerPage_button_edit}" FontFamily="Montserrat Alternates"
                                    HorizontalAlignment="Left"/>
                            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource LeoButtonStyle}" Height="20" Width="160" 
                                    Content="{x:Static res:Resources.commandsViewerPage_button_delete}" FontFamily="Montserrat Alternates"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
